# Copy to .env and fill in real values. Never commit .env or share it in zips.

# Groq: every LLM feature (QA agent, supplier agent, triage agent, and the dashboard
# "explain decision" / "summarize activity" calls via the backend /ai/complete route)
GROQ_API_KEY=your_groq_api_key_here
# Default model for all of them (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional per-agent model overrides
# QA_AGENT_MODEL=openai/gpt-oss-120b
# SUPPLIER_AGENT_MODEL=openai/gpt-oss-120b
# TRIAGE_AGENT_MODEL=openai/gpt-oss-120b
