# Copy to .env and fill in real values. Never commit .env or share it in zips.

# Gemini (QA agent, supplier agent, triage agent)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (dashboard "explain decision" / "summarize activity"), called via the backend /ai/complete route
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional per-agent model overrides
# QA_AGENT_MODEL=gemini-3.6-flash
# SUPPLIER_AGENT_MODEL=gemini-2.5-flash
# TRIAGE_AGENT_MODEL=gemini-3.6-flash
