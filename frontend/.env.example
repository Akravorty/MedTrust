# MediTrust frontend environment
# Copy to .env. No provider API keys here: VITE_* values are public in the built JS.
VITE_API_BASE=http://localhost:8000
# Optional: video server for teleconsults (default https://meet.jit.si). Point at a self-hosted Jitsi for real use.
# VITE_VIDEO_BASE_URL=https://meet.jit.si
